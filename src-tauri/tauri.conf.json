{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sound-open",
  "version": "0.1.0",
  "identifier": "com.hp.sound-open",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sound-open",
        "label": "main",
        "visible": true,
        "url":"/",
        "width": 800,
        "height": 600,
        "minWidth": 800,
        "minHeight": 600,
   
        "backgroundColor": "#f0f0f0"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources":[
      "libs/*"
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
